  <!-- One output root for the whole solution. Every project in this repository
       writes its binaries to out\<Platform>\<Configuration>\ and its
       intermediates to obj\<ProjectName>\ underneath, so a variant is one folder
       rather than six scattered ones. The six target names are distinct, so a
       shared folder is unambiguous, and it lands each executable next to the
       DLLs it loads, which is what the xcopy post-build steps in the test and
       example projects used to arrange by hand.

       Anchored on $(MSBuildThisFileDirectory), not $(SolutionDir): the path must
       not depend on which solution drives the build. Relying on the MSBuild
       defaults is what left TargetCore with intermediates and binaries in
       different trees (see its 0cc271a). -->
  <PropertyGroup>
    <OutDir>$(MSBuildThisFileDirectory)out\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)out\$(Platform)\$(Configuration)\obj\$(ProjectName)\</IntDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <TargetName>TargetFacade</TargetName>
    <LinkIncremental>true</LinkIncremental>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <TargetName>TargetFacade</TargetName>
    <LinkIncremental>false</LinkIncremental>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">
