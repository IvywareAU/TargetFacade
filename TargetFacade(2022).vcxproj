    <LinkIncremental>false</LinkIncremental>
  </PropertyGroup>

  <!-- Stage the kernel DLLs the facade loads at run time into the shared output
       folder. Done once here rather than three times over in the test and
       example projects, and keyed by $(Configuration)$(PlatformArchitecture) so
       Win32 draws from bin\Debug32 / bin\Release32 and x64 from bin\Debug64 /
       bin\Release64. The old copies were hardcoded to the 64-bit pair, so the
       32-bit output folders never got a kernel at all. -->
  <ItemDefinitionGroup>
    <PostBuildEvent>
      <Command>xcopy /Y "$(MSBuildThisFileDirectory)..\bin\$(Configuration)$(PlatformArchitecture)\Msgcore.dll" "$(OutDir)"
xcopy /Y "$(MSBuildThisFileDirectory)..\bin\$(Configuration)$(PlatformArchitecture)\TargetCore.dll" "$(OutDir)"</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>

