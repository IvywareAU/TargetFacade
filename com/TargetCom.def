;
; TargetCom.def -- the four (plus one) entry points an in-proc COM server owes
; the system.  Nothing of the facade's own ABI is re-exported here: a C++
; client that wants the flat interfaces links TargetFacade.lib directly.
EXPORTS
	DllCanUnloadNow		PRIVATE
	DllGetClassObject	PRIVATE
	DllRegisterServer	PRIVATE
	DllUnregisterServer	PRIVATE
	DllInstall		PRIVATE
