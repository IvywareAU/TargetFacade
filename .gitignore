# Single build output root, shared by all six projects in the solution:
#   out\<Platform>\<Configuration>\            binaries
#   out\<Platform>\<Configuration>\obj\<Proj>\ intermediates
# Pinned in each .vcxproj. The old per-project x64\ and Win32\ trees -- one pair
# at the repository root and one beside every other project -- are no longer
# produced.
out/

.vs/
*.user
*.aps

